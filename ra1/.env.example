# ============================================================
# RA1 Environment Configuration
# Merged from King + 10kant
# ============================================================

# --- Database ---
POSTGRES_USER=ra1
POSTGRES_PASSWORD=ra1secret
POSTGRES_DB=ra1
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Valkey (Cache) ---
VALKEY_URL=

# --- ClickHouse (Analytics) ---
CLICKHOUSE_URL=

# --- Qdrant (Vector DB) ---
QDRANT_URL=

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434

# --- LiteLLM (Model Proxy) ---
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-ra1-litellm-master

# --- Infisical (Secret Vault) ---
INFISICAL_URL=https://app.infisical.com
INFISICAL_ENCRYPTION_KEY=your-32-char-encryption-key-abc123
INFISICAL_AUTH_SECRET=your-infisical-auth-secret-here
INFISICAL_DB_PASSWORD=infisical-secret
INFISICAL_SERVICE_TOKEN=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# --- JWT / Auth ---
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# === Model Provider Keys ===
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# === Langfuse (Observability) ===
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_SALT=your-random-salt-string

# === LibreChat (Chat UI) ===
CREDS_KEY=your-32-char-creds-key-here-abc123
CREDS_IV=your-16-char-iv-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# === MinIO (S3-compatible storage for Langfuse) ===
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# === Redis (for Langfuse queues) ===
REDIS_AUTH=ra1redissecret

# === API ===
API_PORT=3001
NODE_ENV=development
