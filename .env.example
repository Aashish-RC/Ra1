# ============================================================
# RA1 Environment Configuration
# ============================================================
#
# TWO MODES:
#   1. Quick start (no Infisical) — fill in the 5 vars below
#   2. Full stack — uses Infisical for secrets management
#
# ============================================================

# ── Quick start (no Infisical required) ─────────────────────
# These 5 vars are enough to run:
#   docker compose up -d canvas api postgres valkey litellm
# Generate with: openssl rand -hex 32

POSTGRES_PASSWORD=          # any password, e.g. ra1local
LITELLM_MASTER_KEY=         # format: sk-ra1-XXXX (generate: openssl rand -hex 16)
JWT_SECRET=                 # generate: openssl rand -hex 32
INFISICAL_ENCRYPTION_KEY=   # generate: openssl rand -hex 16  (exactly 32 hex chars)
INFISICAL_AUTH_SECRET=      # generate: openssl rand -hex 32

# ── Infisical (skip for quick start) ────────────────────────
# Leave blank to bypass Infisical — secrets load from env directly
INFISICAL_SERVICE_TOKEN=
INFISICAL_SYSTEM_PROJECT_ID=
INFISICAL_PROVIDERS_PROJECT_ID=

# ── Recommended (non-sensitive) ─────────────────────────────
POSTGRES_USER=ra1
POSTGRES_DB=ra1
API_PORT=3001
NODE_ENV=development
INFISICAL_ENVIRONMENT=dev
INFISICAL_URL=http://localhost:8080
INFISICAL_DB_PASSWORD=
REDIS_AUTH=
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
LIBRECHAT_APP_SECRET=
VITE_API_URL=http://localhost:3001