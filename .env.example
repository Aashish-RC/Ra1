# ============================================================
# RA1 Environment Configuration
# ============================================================
# HOW SECRETS WORK:
#
# TIER 1 — SUPER ADMIN (system secrets)
# Stored in Infisical project: ra1-system
# Only the API bootstrap service token reads these.
# You set these once during initial setup.
#
# TIER 2 — ADMIN (shared provider keys)
# Stored in Infisical project: ra1-providers, path: /shared/
# You manage these via the Infisical UI or admin API.
# These are the default provider keys users fall back to.
#
# TIER 3 — USER (BYOK keys)
# Stored in Infisical project: ra1-providers, path: /users/{userId}/
# Users store their own keys via the vault UI.
# Never set by you — managed entirely by users.
#
# FOR LOCAL DEV:
# Only the bootstrap variables below are needed in .env
# Everything else is fetched from Infisical at startup.
# ============================================================


# ── Bootstrap (needed before Infisical can be reached) ──────
# These are the ONLY secrets that go in .env
# Everything else lives in Infisical.

# Which Infisical instance to use
INFISICAL_URL=http://localhost:8080

# Service token for the API to read secrets from Infisical
# Create this in Infisical UI: Project ra1-system → Service Tokens
INFISICAL_SERVICE_TOKEN=

# Project IDs (find in Infisical UI after creating projects)
INFISICAL_SYSTEM_PROJECT_ID=
INFISICAL_PROVIDERS_PROJECT_ID=

# Environment to read from (dev / staging / production)
INFISICAL_ENVIRONMENT=dev


# ── Infisical self-host setup (needed to start Infisical itself) ─
# These bootstrap Infisical before Infisical can manage secrets.
# Generate with: openssl rand -hex 16 (ENCRYPTION_KEY must be 32 chars)
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=


# ── Infrastructure (non-secret, safe as env vars) ───────────
POSTGRES_USER=ra1
POSTGRES_DB=ra1
API_PORT=3001
NODE_ENV=development


# ── Secrets that MUST be in Infisical project ra1-system ────
# Do NOT set these here in production. Listed for documentation only.
# In Infisical, create secrets with exactly these names:
#
# POSTGRES_PASSWORD            — main DB password
# REDIS_AUTH                   — Redis password
# MINIO_ROOT_USER              — MinIO access key
# MINIO_ROOT_PASSWORD          — MinIO secret key
# LITELLM_MASTER_KEY           — LiteLLM gateway master key (format: sk-...)
# LANGFUSE_PUBLIC_KEY          — Langfuse public key
# LANGFUSE_SECRET_KEY          — Langfuse secret key
# LANGFUSE_SALT                — Langfuse NextAuth secret + salt
# JWT_SECRET                   — API JWT signing secret
# SESSION_SECRET               — API session secret
# CREDS_KEY                    — LibreChat credentials encryption key (32 chars)
# CREDS_IV                     — LibreChat credentials IV (16 chars)
# JWT_REFRESH_SECRET           — LibreChat JWT refresh secret
# LIBRECHAT_APP_SECRET         — LibreChat session secret (32+ chars)
#
# Infrastructure URLs (also in ra1-system):
# DATABASE_URL=postgresql://ra1:${POSTGRES_PASSWORD}@postgres:5432/ra1
# VALKEY_URL=redis://valkey:6379
# CLICKHOUSE_URL=http://clickhouse:8123
# QDRANT_URL=http://qdrant:6333
# OLLAMA_BASE_URL=http://ollama:11434
# LITELLM_URL=http://litellm:4000


# ── Secrets that MUST be in Infisical project ra1-providers ─
# Admin manages these under path /shared/:
#
# PROVIDER_KEY_OPENAI
# PROVIDER_KEY_ANTHROPIC
# PROVIDER_KEY_GEMINI
# PROVIDER_KEY_MISTRAL
# PROVIDER_KEY_GROQ
# PROVIDER_KEY_TOGETHER